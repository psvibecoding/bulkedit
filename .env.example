NODE_ENV=production
PORT=8787
SHOPIFY_API_VERSION=2026-01
ALLOWED_ORIGINS=https://your-domain.com
SHOPIFY_TIMEOUT_MS=15000

# Scheduling
# CRITICAL on Railway: SCHED_FILE must point to a mounted Volume path.
# Without a Volume, schedules.json is wiped on every deploy.
# In Railway: Settings → Volumes → Mount at /data
SCHED_SECRET=change-me-to-a-long-random-string
SCHED_FILE=/data/schedules.json

# Email notifications (Resend)
RESEND_API_KEY=re_your_api_key_here
NOTIFY_FROM=noreply@yourdomain.com
NOTIFY_TZ=Europe/Rome
CONTACT_TO=your-email@example.com

# Protects /api/schedule/ping from public access
PING_SECRET=change-me-to-a-random-string
