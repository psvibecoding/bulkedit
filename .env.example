NODE_ENV=production
PORT=8787
SHOPIFY_API_VERSION=2026-01
ALLOWED_ORIGINS=https://your-domain.com
RATE_LIMIT_PER_MINUTE=120
WRITE_LIMIT_PER_MINUTE=30
SHOPIFY_TIMEOUT_MS=15000
ENABLE_RAW_GRAPHQL=false

# Scheduling
SCHED_SECRET=change-me-to-a-long-random-string
SCHED_FILE=/data/schedules.json

# Email notifications (Brevo / Sendinblue)
BREVO_API_KEY=your-brevo-api-key
NOTIFY_FROM=noreply@yourdomain.com
CONTACT_TO=your-email@example.com
